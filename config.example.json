{
  "_说明_1": "通用能力评测配置。被测对象共 5 个：盘古7B 微调前/后、Qwen8B 微调前/后、Qwen3-32B。",
  "_说明_2": "阶段 1（微调前）：python -m geval run --config config.json --models pangu7b-pre,qwen8b-pre,qwen3-32b",
  "_说明_3": "阶段 1.5（微调后）：微调完成后直接跑全量，config 里 5 个模型都已定义：python -m geval run --config config.json --resume",
  "_说明_4": "base_url / model 都是占位值，务必改成你实际部署的地址与模型名。",
  "_说明_5": "qwen3-32b 走 reqbody_gateway：现网网关要求整个请求体包在 reqBody 里、鉴权放 body 内（实现见 geval/reqbody_gateway.py）。user_suffix 会追加到 user 消息末尾，如 Qwen3 的 /no_think；网关是否支持 logprobs / completions 未知，故关掉 logprobs。",

  "run_name": "geval-general-5objects",
  "output_dir": "runs",
  "data_root": "datasets",
  "seed": 42,

  "concurrency": 8,
  "request_timeout_s": 180,
  "retries": 3,
  "proxy": "bypass",

  "cache": true,
  "cache_dir": ".cache/geval",

  "report": {
    "bootstrap": 2000,
    "alpha": 0.05,
    "baseline": "qwen3-32b",
    "pairs": [
      ["pangu7b-pre", "pangu7b-post"],
      ["qwen8b-pre", "qwen8b-post"]
    ]
  },

  "models": [
    {
      "id": "pangu7b-pre",
      "label": "盘古7B（微调前）",
      "provider": "openai_compat",
      "base_url": "http://127.0.0.1:8001/v1",
      "api_key": "EMPTY",
      "model": "pangu-7b-instruct",
      "params": { "temperature": 0, "top_p": 1.0, "max_tokens": 1024 },
      "extra_body": {},
      "supports_logprobs": true
    },
    {
      "id": "pangu7b-post",
      "label": "盘古7B（微调后）",
      "provider": "openai_compat",
      "base_url": "http://127.0.0.1:8004/v1",
      "api_key": "EMPTY",
      "model": "pangu-7b-intent-sft",
      "params": { "temperature": 0, "top_p": 1.0, "max_tokens": 1024 },
      "extra_body": {},
      "supports_logprobs": true
    },
    {
      "id": "qwen8b-pre",
      "label": "Qwen8B（微调前）",
      "provider": "openai_compat",
      "base_url": "http://127.0.0.1:8002/v1",
      "api_key": "EMPTY",
      "model": "qwen3-8b-instruct",
      "params": { "temperature": 0, "top_p": 1.0, "max_tokens": 1024 },
      "extra_body": { "chat_template_kwargs": { "enable_thinking": false } },
      "supports_logprobs": true
    },
    {
      "id": "qwen8b-post",
      "label": "Qwen8B（微调后）",
      "provider": "openai_compat",
      "base_url": "http://127.0.0.1:8005/v1",
      "api_key": "EMPTY",
      "model": "qwen3-8b-intent-sft",
      "params": { "temperature": 0, "top_p": 1.0, "max_tokens": 1024 },
      "extra_body": { "chat_template_kwargs": { "enable_thinking": false } },
      "supports_logprobs": true
    },
    {
      "id": "qwen3-32b",
      "label": "Qwen3-32B（现网基线）",
      "provider": "reqbody_gateway",
      "base_url": "http://<现网网关地址>/model/v1",
      "api_key": "sk-xxx",
      "model": "chat-short-ma",
      "params": { "temperature": 0.1, "top_p": 0.1, "max_tokens": 2048 },
      "user_suffix": "/no_think",
      "supports_logprobs": false
    }
  ],

  "_说明_协议": "ceval 起三个 tag 做 prompt 协议消融：fewshot / direct / loglikelihood，用来回答「小模型该用哪种问法」。",
  "tasks": [
    { "name": "ceval", "tag": "ceval-fewshot", "split": "val", "num_fewshot": 5, "protocol": "fewshot", "mode": "gen" },
    { "name": "ceval", "tag": "ceval-direct", "split": "val", "num_fewshot": 0, "protocol": "direct", "mode": "gen" },
    { "name": "ceval", "tag": "ceval-likelihood", "split": "val", "num_fewshot": 5, "mode": "loglikelihood", "primary": "acc_norm" },
    { "name": "cmmlu", "split": "test", "num_fewshot": 5, "protocol": "fewshot", "mode": "gen" },
    { "name": "gsm8k", "split": "test", "num_fewshot": 4, "mode": "gen" },
    { "name": "bbh", "split": "test", "num_fewshot": 0, "protocol": "answer_line", "mode": "gen" },
    { "name": "ifeval", "split": "test", "num_fewshot": 0, "mode": "gen" },
    { "name": "json_schema", "split": "test", "num_fewshot": 0, "mode": "gen", "strict_json": true }
  ]
}
